; BZ_ODF_SHAMAN — visual ODF authoring & simulation laboratory
; Godot 4.7 project. See docs/ARCHITECTURE.md.

config_version=5

[application]

config/name="BZ_ODF_SHAMAN"
config/description="Visual ODF authoring, simulation and native-validation laboratory for Battlezone: Combat Commander."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/favicon.png"

[display]

window/size/viewport_width=1680
window/size/viewport_height=980
window/size/mode=2
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=true
theme/default_font_antialiasing=0
theme/default_font_subpixel_positioning=0
theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.106, 0.071, 0.043, 1)

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false
